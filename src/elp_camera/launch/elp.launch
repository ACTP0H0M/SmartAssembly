<launch>

  <!--<node pkg="nodelet" type="nodelet" name="nodelet_manager" args="manager" output="screen"/>-->

  <node pkg="libuvc_camera" type="camera_node" name="elp_camera" output="screen">
    <param name="frame_id" value="elp_camera" />
    <!-- Parameters used to find the camera -->
    <param name="vendor" value="0x32e4"/>
    <param name="product" value="0x8830"/>

    <!-- Image size and type -->
    <param name="width" value="640"/>
    <param name="height" value="480"/>
    <param name="video_mode" value="yuyv"/>
    <param name="frame_rate" value="30"/>

    <!-- <param name="camera_info_url" value="file://$(find my_camera)/config/elp.yaml"/> -->
  </node>


</launch>